# Anthropic API key — used by the Research Desk worker to generate Etsy niche ideas.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the model used for idea generation. Defaults to a cheap/fast model.
ANTHROPIC_IDEA_MODEL=claude-haiku-4-5-20251001

# Upstash Redis — used to store the running feed. Easiest path: in your Vercel
# project dashboard, Storage tab > add the Upstash integration, and it will
# inject these automatically. For local dev, create a free DB at
# https://console.upstash.com/ and paste the REST credentials here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: free Pollinations.ai account token — removes the watermark and
# raises the anonymous rate limit. Not required to run this project.
# Register at https://pollinations.ai/
POLLINATIONS_TOKEN=

# CRON_SECRET is auto-populated by Vercel once you deploy a project with a
# crons entry in vercel.json — you don't need to set this yourself in
# production. Leave blank locally; the cron routes skip auth checks when it's unset.
CRON_SECRET=
