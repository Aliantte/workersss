# Anthropic API key — used by Aliantte, the sync meeting, and Ally Al.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the model used everywhere. Defaults to a cheap/fast model.
ANTHROPIC_IDEA_MODEL=claude-haiku-4-5-20251001

# Postgres (Neon) — the pipeline's database. Easiest path: in your Vercel
# project's Storage tab, add a Postgres integration (Neon) — it injects
# DATABASE_URL automatically. Tables are created automatically on first
# request, no manual migration step. For local dev, create a free Neon
# project at https://neon.tech and paste its connection string here.
DATABASE_URL=

# Vercel Blob — stores the generated design images. In your Vercel project's
# Storage tab, add a Blob store — it injects BLOB_READ_WRITE_TOKEN
# automatically. For local dev, create one at vercel.com and paste the token.
BLOB_READ_WRITE_TOKEN=

# Optional: free Pollinations.ai account token — removes the watermark and
# raises the anonymous rate limit. Not required to run this project.
# Register at https://pollinations.ai/
POLLINATIONS_TOKEN=

# Optional: Twitch API credentials — powers the "Twitch clip roundup" social
# niche (real trending clips, not AI-generated). Free — register an app at
# https://dev.twitch.tv/console/apps to get both values below. If left blank,
# that one niche is silently skipped each time it comes up in rotation;
# everything else keeps working.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# CRON_SECRET is auto-populated by Vercel once you deploy a project with a
# crons entry in vercel.json — you don't need to set this yourself in
# production. Leave blank locally; the cron routes skip auth checks when it's unset.
CRON_SECRET=
